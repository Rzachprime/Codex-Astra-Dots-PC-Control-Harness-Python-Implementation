    keys = [KEYS[k] for k in names]
    return ([keyboard_event(vk=k, flags=int(k in EXTENDED)) for k in keys]
            + [keyboard_event(vk=k, flags=2 | int(k in EXTENDED)) for k in reversed(keys)])


